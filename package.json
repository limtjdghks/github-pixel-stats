{
  "name": "github-pixel-stats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "generate": "node --import tsx src/cli/generate.ts",
    "build:fixture": "node --import tsx src/cli/build-fixture.ts",
    "validate:output": "node --import tsx src/cli/validate-output.ts",
    "build:cards": "npm run typecheck && npm run generate && npm run validate:output -- --state build/next-state.json --out dist",
    "build": "npm run typecheck && npm run build:fixture"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.9.11",
    "@vercel/oidc": "3.8.10",
    "fast-xml-parser": "5.11.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
