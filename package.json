{
  "name": "github-pixel-stats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "tsx src/cli/generate.ts",
    "validate:output": "tsx src/cli/validate-output.ts",
    "build": "npm run typecheck && npm run generate && npm run validate:output -- --state build/next-state.json --out dist"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
