{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/health.ts": {
      "regions": ["iad1"],
      "maxDuration": 10
    },
    "api/card.ts": {
      "regions": ["iad1"],
      "maxDuration": 30,
      "includeFiles": "{assets/fonts/**/*.woff2,data/languages.yml}"
    },
    "api/cron.ts": {
      "regions": ["iad1"],
      "maxDuration": 300,
      "includeFiles": "{assets/fonts/**/*.woff2,data/languages.yml}"
    }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "17 18 * * *" }
  ],
  "rewrites": [
    { "source": "/healthz", "destination": "/api/health" },
    { "source": "/:username/stats.svg", "destination": "/api/card?__card=stats&__username=:username" },
    { "source": "/:username/languages.svg", "destination": "/api/card?__card=languages&__username=:username" }
  ]
}
